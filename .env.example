# Footballguys credentials
FBG_EMAIL=
FBG_PASSWORD=

# Database connection string (override defaults if needed)
# Example for Windows with Trusted Connection
# DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=TonyDB;Trusted_Connection=yes;Connection Timeout=5;
# Example for SQL auth
# DB_CONN_STR=DRIVER={ODBC Driver 17 for SQL Server};SERVER=localhost;DATABASE=TonyDB;UID=sa;PWD=YourPassword;Connection Timeout=5;

# Runtime options
WEEK=1
YEAR=2025
TABLE_NAME=FootballStats
HEADLESS=false
USE_GUI=true
# If Chrome is installed in a non-standard path, set:
# CHROME_BINARY=/usr/bin/google-chrome
# Optional: save last scrape to CSV
# OUT_CSV=output.csv